# ==========================================
# إعدادات بوت الإدارة والمالك (إلزامية)
# ==========================================
BOT_TOKEN=1234567890:AAH_YOUR_ADMIN_BOT_TOKEN_HERE
OWNER_ID=123456789

# ==========================================
# إعدادات تطبيق تيليجرام للحساب الشخصي (my.telegram.org)
# ==========================================
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef

# ==========================================
# مفتاح تشفير جلسة الحساب الشخصي (Fernet 32-byte url-safe base64)
# لتوليد مفتاح جديد: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ==========================================
SECRET_ENCRYPTION_KEY=GENERATE_AND_PASTE_FERNET_KEY_HERE

# ==========================================
# إعدادات قاعدة البيانات والنظام
# ==========================================
DATABASE_URL=sqlite+aiosqlite:///./data/secretary_bot.db
TIMEZONE=Asia/Aden
LOG_LEVEL=INFO
MEDIA_CACHE_DIR=./data/media_cache
BACKUP_DIR=./backups
LOG_DIR=./logs

# ==========================================
# ضوابط الأمان ومعدلات الإرسال المحافظة (بالثواني)
# ==========================================
BROADCAST_MIN_DELAY_SECONDS=5.0
BROADCAST_MAX_DELAY_SECONDS=12.0
MAX_DELETE_RETRIES=3
